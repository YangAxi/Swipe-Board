{
  "name": "swipe-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "tsc --noEmit && vite build --base=/Swipe-Board/ --outDir=dist-pages",
    "preview:pages": "vite preview --host 127.0.0.1 --port 4174 --strictPort --outDir=dist-pages --base=/Swipe-Board/",
    "test:pages": "playwright test --config=playwright.pages.config.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
